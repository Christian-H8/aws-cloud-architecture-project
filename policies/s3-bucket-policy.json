{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "AllowS3ReaderReadAccess",
            "Effect": "Allow",
            "Principal": {
                "AWS": "arn:aws:iam::YOUR-ACCOUNT-ID:user/project1-s3-reader"
            },
            "Action": [
                "s3:GetObject",
                "s3:ListBucket"
            ],
            "Resource": [
                "arn:aws:s3:::project1-storage-hc-2026",
                "arn:aws:s3:::project1-storage-hc-2026/*"
            ]
        }
    ]
}